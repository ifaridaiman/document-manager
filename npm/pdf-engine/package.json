{
  "name": "@documentmanager/pdf-engine",
  "version": "0.3.0",
  "description": "Stateless PDF inspect, text, render and region-capture engine (Go + PDFium) for Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifaridaiman/document-manager.git",
    "directory": "npm/pdf-engine"
  },
  "homepage": "https://github.com/ifaridaiman/document-manager#readme",
  "bugs": "https://github.com/ifaridaiman/document-manager/issues",
  "keywords": [
    "pdf",
    "pdfium",
    "render",
    "capture",
    "evidence",
    "llm",
    "nextjs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sh scripts/build-binaries.sh",
    "build:local": "sh scripts/build-binaries.sh local",
    "prepare-release": "node scripts/prepare-release.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
