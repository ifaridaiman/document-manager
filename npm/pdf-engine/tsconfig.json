{
  // Type-checks the plain-JS wrapper against its hand-written index.d.ts, so the
  // declarations cannot drift from what index.js returns. Nothing is emitted.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["src"]
}
